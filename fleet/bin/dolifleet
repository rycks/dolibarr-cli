#!/usr/bin/env php
<?php

declare(strict_types=1);

/*
 * dolifleet - pilot of a fleet of Dolibarr servers through dolicli.
 *
 * Copyright (c) 2025-2026 Eric Seigne <eric.seigne@cap-rel.fr>
 * SPDX-License-Identifier: AGPL-3.0-or-later
 */

if (PHP_VERSION_ID < 80200) {
    fwrite(STDERR, 'dolifleet needs PHP 8.2 or later, this is PHP '.PHP_VERSION."\n");
    exit(3);
}

require dirname(__DIR__, 2).'/vendor/autoload.php';

$application = Dolifleet\Kernel::application();
exit($application->run(Dolifleet\Kernel::input($application, array_values(array_map('strval', $_SERVER['argv'] ?? [])))));
