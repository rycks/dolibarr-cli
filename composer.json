{
  "name": "rycks/dolibarr-cli",
  "description": "dolicli: Dolibarr administration from the command line (server body, PHP 7.0+)",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/rycks/dolibarr-cli",
  "keywords": [
    "cli",
    "command-line",
    "dolibarr",
    "erp"
  ],
  "autoload-dev": {
    "classmap": [
      "build/lib/"
    ]
  },
  "bin": [
    "dolibarr",
    "dolicli",
    "dolifleet"
  ],
  "require": {
    "php": ">=8.2",
    "symfony/console": "^7.3",
    "symfony/yaml": "^7.3",
    "symfony/process": "^7.3"
  },
  "require-dev": {
    "pestphp/pest": "^3.8",
    "laravel/pint": "^1.30",
    "phpstan/phpstan": "^2.1",
    "cap-rel/dolibarr-integration-sqlite": "18.0.x-dev",
    "squizlabs/php_codesniffer": "^3.13",
    "phpcompatibility/php-compatibility": "^10.0@alpha",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "opis/json-schema": "^2.4",
    "humbug/box": "^4.7"
  },
  "scripts": {
    "build": "php build/build-server.php",
    "test": "pest",
    "phpstan": "phpstan analyse --memory-limit=1G"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "autoload": {
    "psr-4": {
      "Dolifleet\\": "fleet/src/",
      "Dolicli\\": "server/src/"
    }
  }
}
