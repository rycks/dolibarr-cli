{
  "name": "rycks/dolibarr-cli",
  "description": "Dolibarr administration from the command line",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/rycks/dolibarr-cli",
  "keywords": [
    "cli",
    "command-line",
    "dolibarr",
    "erp"
  ],
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "bin": [
    "dolibarr"
  ],
  "require": {
    "php": ">=8.2",
    "minicli/minicli": "^4.2",
    "symfony/polyfill-mbstring": "^1.31"
  },
  "require-dev": {
    "pestphp/pest": "^3.8",
    "laravel/pint": "^1.30",
    "humbug/box": "^4.7",
    "phpstan/phpstan": "^2.1",
    "cap-rel/dolibarr-integration-sqlite": "18.0.x-dev"
  },
  "scripts": {
    "build": "box compile",
    "lint": [
      "pint"
    ],
    "test:lint": [
      "@php -l dolibarr",
      "pint --test"
    ],
    "test:unit": [
      "pest"
    ],
    "test": [
      "@test:lint",
      "@test:unit"
    ],
    "phpstan": [
      "phpstan analyse --memory-limit=1G"
    ]
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
