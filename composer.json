{
  "name": "rycks/dolibarr-cli",
  "description": "Dolibarr administration from the command line",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/rycks/dolibarr-cli",
  "keywords": [
    "cli",
    "command-line",
    "dolibarr",
    "erp"
  ],
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Dolicli\\": "server/src/"
    },
    "classmap": [
      "build/lib/"
    ]
  },
  "bin": [
    "dolibarr"
  ],
  "require": {
    "php": ">=8.2",
    "minicli/minicli": "^4.2",
    "symfony/polyfill-mbstring": "^1.31"
  },
  "require-dev": {
    "pestphp/pest": "^3.8",
    "laravel/pint": "^1.30",
    "humbug/box": "^4.7",
    "phpstan/phpstan": "^2.1",
    "cap-rel/dolibarr-integration-sqlite": "18.0.x-dev",
    "squizlabs/php_codesniffer": "^3.13",
    "phpcompatibility/php-compatibility": "^10.0@alpha",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "opis/json-schema": "^2.4"
  },
  "scripts": {
    "build": "box compile",
    "lint": [
      "pint"
    ],
    "test:lint": [
      "@php -l dolibarr",
      "pint --test"
    ],
    "test:unit": [
      "pest"
    ],
    "test": [
      "@test:lint",
      "@test:unit"
    ],
    "phpstan": [
      "phpstan analyse --memory-limit=1G"
    ]
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
