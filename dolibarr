if (PHP_SAPI !== 'cli') {
    exit(1);
}

if (!defined('NOSESSION')) {
    define('NOSESSION', '1');
}

// Global option entity=N: work on another company of a multicompany setup.
foreach ($argv as $arg) {
    if (preg_match('/^(?:--)?entity=(\d+)$/', $arg, $matches)) {
        define('DOLENTITY', (int) $matches[1]);
    }
}

// Include Dolibarr environment
$path = rtrim((string) (getenv('DOLPATH') ?: './htdocs'), '/');
if (!is_file($path . '/master.inc.php')) {
    fwrite(STDERR, "Dolibarr not found in '" . $path . "': put the sources in ./htdocs or set the DOLPATH environment variable.\n");
    exit(1);
}

// master.inc.php prints HTML on fatal errors (database unreachable...) and may exit:
// strip the tags of anything it prints, then stop buffering.
ob_start(static fn (string $buffer): string => strip_tags($buffer));
chdir($path);
require_once './master.inc.php';
ob_end_flush();

require __DIR__ . '/vendor/autoload.php';

use App\Support\ExitStatus;
use App\Util\DolibarrHelper;
use Minicli\App;
use Minicli\Exception\CommandNotFoundException;

$app = new App();

// Without a command, show the general help.
if (count($argv) < 2) {
    $argv[] = 'help';
}

try {
    $app->runCommand($argv);
} catch (CommandNotFoundException $notFoundException) {
    fwrite(STDERR, "Command not found. Run ./dolibarr without argument for the list of commands.\n");
    exit(1);
} catch (Throwable $exception) {
    DolibarrHelper::log('uncaught ' . get_class($exception) . ': ' . $exception->getMessage(), LOG_ERR);
    fwrite(STDERR, 'Error: ' . $exception->getMessage() . "\n");
    if ($app->config->trace) {
        fwrite(STDERR, $exception->getTraceAsString() . "\n");
    }
    exit(1);
}

exit(ExitStatus::get());
